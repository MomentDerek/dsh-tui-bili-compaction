{
  "name": "dsh-tui-bili-compaction",
  "version": "0.1.1",
  "description": "dsh-TUI 专用上下文压缩：在 dsh 进程内直接运行 billion-context 内核（acp-kernel 的 3-tier LSM），替代 bili 代理级压缩。",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check:manifest": "node scripts/check-manifest.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-tui",
    "billion-context",
    "acp-kernel",
    "compaction"
  ],
  "author": "MomentDerek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MomentDerek/dsh-tui-bili-compaction.git"
  },
  "homepage": "https://github.com/MomentDerek/dsh-tui-bili-compaction#readme",
  "bugs": {
    "url": "https://github.com/MomentDerek/dsh-tui-bili-compaction/issues"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
