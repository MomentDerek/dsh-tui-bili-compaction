{
  "name": "dsh-tui-bili-compaction",
  "version": "0.1.0",
  "description": "dsh-TUI 专用上下文压缩：在 dsh 进程内直接运行 billion-context 内核（acp-kernel 的 3-tier LSM），替代 bili 代理级压缩。",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-tui",
    "billion-context",
    "acp-kernel",
    "compaction"
  ],
  "license": "MIT"
}
